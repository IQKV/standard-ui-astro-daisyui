{
  "name": "@iqkv/standard-ui-blank-astro-daisyui-ssr",
  "version": "0.0.0",
  "description": "A minimal Astro boilerplate with Tailwind, DaisyUI, React islands",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "dev": "astro dev",
    "formatter:check": "oxfmt --check",
    "formatter:write": "oxfmt --write",
    "lint": "pnpm lint:eslint",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:eslint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "node_modules:cleanup": "rm -rf node_modules",
    "prepare": "husky",
    "preview": "astro preview",
    "release": "release-it --ci",
    "start": "node dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/node": "^10.0.6",
    "@astrojs/react": "^5.0.4",
    "@astrojs/tailwind": "^6.0.2",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "astro": "^6.1.9",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^6.12.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cz-conventional-changelog": "^3.3.0",
    "daisyui": "^5.5.19",
    "eslint": "^10.2.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "glob": "^13.0.6",
    "globals": "^17.5.0",
    "husky": "9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.0",
    "prettier-plugin-astro": "^0.14.1",
    "release-it": "^19.2.4",
    "release-it-pnpm": "^4.6.6",
    "sort-package-json": "^3.6.1",
    "tsdown": "^0.21.10",
    "typescript-eslint": "^8.59.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "oxlint --type-aware",
      "oxfmt --write"
    ],
    "*.{css,json,md}": [
      "oxfmt --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.0"
}
