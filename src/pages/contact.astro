---
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";

const sent = Astro.url.searchParams.has("sent");
const error = Astro.url.searchParams.get("error");

// Repopulate fields from query params so users don't lose their input
// after a validation error redirect.
const prevName = Astro.url.searchParams.get("name") ?? "";
const prevEmail = Astro.url.searchParams.get("email") ?? "";
const prevMessage = Astro.url.searchParams.get("message") ?? "";
---

<BaseLayout title="Contact" description="Get in touch">
  <section class="flex flex-col items-center px-4 py-20 animate-fade-in">
    <div class="w-full max-w-lg">

      <!-- Header -->
      <div class="mb-8 animate-slide-up">
        <h1 class="text-4xl font-bold tracking-tight mb-2">Get in touch</h1>
        <p class="text-base-content/60">We'll get back to you as soon as possible.</p>
      </div>

      <!-- Alerts -->
      {sent && (
        <div role="alert" class="alert alert-success mb-6 shadow-sm animate-slide-up">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Message sent — we'll be in touch soon.</span>
        </div>
      )}
      {error && (
        <div role="alert" class="alert alert-error mb-6 shadow-sm animate-slide-up">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{error}</span>
        </div>
      )}

      <!-- Card -->
      <div class="card bg-base-100 border border-base-300 shadow-sm animate-slide-up">
        <div class="card-body gap-5">
          <form id="contact-form" action="/api/contact" method="POST" class="flex flex-col gap-5" novalidate>

            <!-- Name -->
            <fieldset class="fieldset">
              <legend class="fieldset-legend text-sm font-medium text-base-content/80">Name</legend>
              <input
                type="text"
                name="name"
                id="field-name"
                placeholder="Jane Smith"
                value={prevName}
                class="input input-bordered w-full focus:input-primary transition-colors"
                aria-describedby="error-name"
              />
              <p id="error-name" class="text-error text-sm mt-1 hidden"></p>
            </fieldset>

            <!-- Email -->
            <fieldset class="fieldset">
              <legend class="fieldset-legend text-sm font-medium text-base-content/80">Email</legend>
              <input
                type="email"
                name="email"
                id="field-email"
                placeholder="jane@example.com"
                value={prevEmail}
                class="input input-bordered w-full focus:input-primary transition-colors"
                aria-describedby="error-email"
              />
              <p id="error-email" class="text-error text-sm mt-1 hidden"></p>
            </fieldset>

            <!-- Message -->
            <fieldset class="fieldset">
              <legend class="fieldset-legend text-sm font-medium text-base-content/80">Message</legend>
              <textarea
                name="message"
                id="field-message"
                rows="5"
                placeholder="How can we help you?"
                class="textarea textarea-bordered w-full focus:textarea-primary transition-colors resize-none leading-relaxed"
                aria-describedby="error-message"
              >{prevMessage}</textarea>
              <p id="error-message" class="text-error text-sm mt-1 hidden"></p>
            </fieldset>

            <div class="card-actions pt-1">
              <button type="submit" class="btn btn-primary w-full gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                Send message
              </button>
            </div>

          </form>

          <script>
            const form = document.getElementById("contact-form") as HTMLFormElement;

            function showError(id: string, msg: string) {
              const el = document.getElementById(id)!;
              el.textContent = msg;
              el.classList.remove("hidden");
            }

            function clearError(id: string) {
              const el = document.getElementById(id)!;
              el.textContent = "";
              el.classList.add("hidden");
            }

            function validateEmail(value: string) {
              return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
            }

            form.addEventListener("submit", (e) => {
              let valid = true;

              const name = (document.getElementById("field-name") as HTMLInputElement).value.trim();
              const email = (document.getElementById("field-email") as HTMLInputElement).value.trim();
              const message = (document.getElementById("field-message") as HTMLTextAreaElement).value.trim();

              clearError("error-name");
              clearError("error-email");
              clearError("error-message");

              if (!name) {
                showError("error-name", "Name is required");
                valid = false;
              } else if (name.length > 100) {
                showError("error-name", "Name must be 100 characters or fewer");
                valid = false;
              }

              if (!email) {
                showError("error-email", "Email is required");
                valid = false;
              } else if (!validateEmail(email)) {
                showError("error-email", "Enter a valid email address");
                valid = false;
              }

              if (!message) {
                showError("error-message", "Message is required");
                valid = false;
              } else if (message.length > 5000) {
                showError("error-message", "Message must be 5000 characters or fewer");
                valid = false;
              }

              if (!valid) e.preventDefault();
            });
          </script>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
