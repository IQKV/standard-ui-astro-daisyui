---
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";

const sent = Astro.url.searchParams.has("sent");
const error = Astro.url.searchParams.get("error");
---

<BaseLayout title="Contact" description="Get in touch">
  <section class="flex flex-col items-center px-4 py-20">
    <div class="w-full max-w-lg">
      <h1 class="text-4xl font-bold mb-2">Get in touch</h1>
      <p class="text-base-content/60 mb-8">We'll get back to you as soon as possible.</p>

      {sent && <div role="alert" class="alert alert-success mb-4">Message sent — we'll be in touch soon.</div>}
      {error && <div role="alert" class="alert alert-error mb-4">
        {error === "missing" ? "All fields are required." : "Failed to send — please try again."}
      </div>}

      <form action="/api/contact" method="POST" class="flex flex-col gap-4">
        <input type="text" name="name" required placeholder="Name" class="input input-bordered" />
        <input type="email" name="email" required placeholder="Email" class="input input-bordered" />
        <textarea name="message" required rows="5" placeholder="Message" class="textarea textarea-bordered"></textarea>
        <button type="submit" class="btn btn-primary">Send message</button>
      </form>
    </div>
  </section>
</BaseLayout>
